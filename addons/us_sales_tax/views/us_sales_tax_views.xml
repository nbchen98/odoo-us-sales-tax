<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="us_sales_tax_view_list" model="ir.ui.view">
        <field name="name">us.sales.tax.list</field>
        <field name="model">us.sales.tax</field>
        <field name="arch" type="xml">
            <list>
                <field name="state_id"/>
                <field name="rate"/>
            </list>
        </field>
    </record>

    <record id="us_sales_tax_view_form" model="ir.ui.view">
        <field name="name">us.sales.tax.form</field>
        <field name="model">us.sales.tax</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="state_id"/>
                        <field name="rate"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="us_sales_tax_action" model="ir.actions.act_window">
        <field name="name">US Sales Tax Rates</field>
        <field name="res_model">us.sales.tax</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="us_sales_tax_menu_root" name="US Sales Tax"/>
    <menuitem id="us_sales_tax_menu_rates" name="Rates"
              parent="us_sales_tax_menu_root" action="us_sales_tax_action"/>
</odoo>